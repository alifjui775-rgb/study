server {
    listen 80;
    server_name yourdomain.com; # Replace with your actual domain
    root /var/www/mnr/dist; # Replace with the actual path to your dist folder on the VPS
    index index.html;

    # Gzip & Brotli Static Compression
    # (Serves the pre-compressed .gz and .br files generated by Vite)
    gzip_static on;
    # brotli_static on; # Uncomment this ONLY if ngx_brotli is installed on your server

    # Dynamic Gzip compression fallback
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json image/svg+xml font/woff2;
    gzip_disable "MSIE [1-6]\.";

    # CORS Bypass for MNR ID OAuth Token
    location /api/oauth/token {
        proxy_pass https://id.mnr.bd/api/oauth/token;
        proxy_set_header Host id.mnr.bd;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_ssl_server_name on;
    }

    # Never cache index.html, sw.js, and manifest to ensure users always get the latest version
    # This prevents the chunk load error on new builds!
    location ~* (index\.html|sw\.js|manifest\.json|manifest\.webmanifest)$ {
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
    }

    # Cache static assets (JS, CSS, images, fonts) for 1 year since they are hashed by Vite
    # VERY IMPORTANT: return 404 if not found, DO NOT fallback to index.html for assets
    location ~* \.(?:css|js|woff2?|eot|ttf|otf|svg|png|jpg|jpeg|gif|ico|webp|lottie)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # SPA routing fallback: redirect all other requests to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
