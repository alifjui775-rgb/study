# Copy to .env.local and fill in real values

# --- Branding Details ---
VITE_SITE_NAME="MNR Study"
VITE_SITE_SLOGAN=""
VITE_META_DESCRIPTION=""

# --- Assets (Path or URL) ---
VITE_FAVICON_URL="/favicon.svg"
VITE_ICON_URL="/icon.svg"
VITE_LOGO_HEADER="/images/logo-light.png"
VITE_LOGO_DARK_MODE="/images/logo-dark-mode.png"
VITE_OG_IMAGE=""

# --- Theme Colors (HEX Code) ---
VITE_PRIMARY_COLOR="#2C4B9B"
VITE_PRIMARY_SHIFT_COLOR="#3B82F6"
VITE_SECONDARY_COLOR="#F1F5F9"
VITE_PRIMARY_DARK_COLOR="#21A136"
VITE_PRIMARY_DARK_SHIFT_COLOR="#60A5FA"
VITE_SECONDARY_DARK_COLOR="#18181B"

# --- QB or CSV Call ---
VITE_CSV_API_BASE_URL=https://csv.mnr.bd
VITE_CSV_API_KEY=

# --- Database Info ---
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
# Server-only (never reference from client code):
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# --- MNR ID SSO OAuth2 ---
VITE_MNR_CLIENT_ID=
VITE_MNR_REDIRECT_URI=/auth/callback
# Server-only (set in Vercel dashboard for production):
MNR_CLIENT_SECRET=
